# Copy to .env and fill in real values. Never commit .env.
# Setu Data Gateway credentials.
# SETU_API_BASE_URL: sandbox = https://dg-sandbox.setu.co, production = https://dg.setu.co
# Sandbox and production use different credentials too — a sandbox client
# ID/secret will not work against the production host, and vice versa.
SETU_API_BASE_URL=https://dg-sandbox.setu.co
SETU_CLIENT_ID=your-setu-client-id
SETU_CLIENT_SECRET=your-setu-client-secret
SETU_GSTIN_PRODUCT_ID=your-gstin-product-instance-id
SETU_PENNY_DROP_PRODUCT_ID=your-penny-drop-product-instance-id

# Supabase Postgres direct connection.
# NOTE: URL-encode special characters in the password (e.g. '@' -> '%40').
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# App-level auth signing key. Generate with: openssl rand -hex 48
JWT_SECRET=generate-a-long-random-string
